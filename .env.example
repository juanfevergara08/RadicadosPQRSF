# ============================================================
# RadicadosPQRSF - variables de entorno
# Copia este archivo a .env y completa los valores reales.
# .env NUNCA se sube al repositorio.
# ============================================================

# --- Gmail / Google Workspace ---
# Archivo JSON de credenciales OAuth descargado de Google Cloud Console
GMAIL_CREDENTIALS_FILE=credentials/gmail_oauth_client.json
# Donde se guarda el token tras autorizar (se crea solo)
GMAIL_TOKEN_FILE=credentials/gmail_token.json
# Buzón a monitorear.
#   Pruebas:     jvergara@camarapereira.org.co
#   Producción:  unidadcorrespondencia@camarapereira.org.co
GMAIL_MAILBOX=jvergara@camarapereira.org.co
# Buzón definitivo de la unidad de correspondencia
GMAIL_MAILBOX_PRODUCCION=unidadcorrespondencia@camarapereira.org.co
# Consulta Gmail para traer solo lo pendiente (ver sintaxis de búsqueda de Gmail)
GMAIL_QUERY=is:unread -label:Radicado
# Etiqueta que se aplica al correo ya procesado con éxito
GMAIL_LABEL_PROCESSED=Radicado
# Etiqueta para correos que requieren revisión humana
GMAIL_LABEL_REVIEW=PQRSF-Revision
# Etiqueta cuando no se pudo radicar
GMAIL_LABEL_FAILED=PQRSF-Fallido

# --- Sistema de Gestión Documental (DocxFlow) ---
# DocxFlow NO tiene API: se automatiza el navegador con Playwright.
SGD_BASE_URL=https://docxflow.camarapereira.org.co
# Credenciales del usuario con rol para radicar.
# NUNCA las pongas en el chat ni las subas al repositorio.
DOCXFLOW_USER=
DOCXFLOW_PASSWORD=
SGD_TIMEOUT=20
# MODO PRUEBA: mientras sea true NUNCA se escribe en DocxFlow.
# En modo prueba el RPA llena el formulario y se detiene ANTES de enviar.
SGD_MODO_PRUEBA=true
# URL del mock local (solo para pruebas sin navegador)
SGD_MOCK_URL=http://localhost:8080

# --- Clasificación ---
# Umbral de confianza para radicar automáticamente (0.0 a 1.0).
# Por debajo del umbral el correo va a revisión humana, NO se radica.
CLASSIFIER_CONFIDENCE_THRESHOLD=0.75
# Catálogo de áreas y palabras clave
AREAS_CONFIG_FILE=config/areas.yaml

# --- Clasificador IA (opcional en la fase 1) ---
# Si está vacío, solo se usan reglas.
LLM_PROVIDER=
LLM_API_KEY=
LLM_MODEL=

# --- Estado e idempotencia ---
STATE_DB_PATH=var/state.db

# --- Reporte diario de fallidos ---
REPORT_OUTPUT_DIR=var/reportes
# Correos destino del reporte, separados por coma
REPORT_RECIPIENTS=
# Hora local de envío (formato HH:MM)
REPORT_HOUR=18:00
